{
  "entities": {
    "AdminProfile": {
      "title": "AdminProfile",
      "description": "Trusted administrator record for role-based access control.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the administrator"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 256,
          "description": "Verified email address of the administrator"
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "admin"],
          "maxLength": 32,
          "description": "Administrative tier"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "TeacherRecord": {
      "title": "TeacherRecord",
      "description": "Teacher profile stored in Cloud Firestore.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
