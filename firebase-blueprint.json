  "firestore": {
    "/admins/{adminUid}": {
      "schema": "AdminProfile",
      "description": "Administrator registry collection keyed by Firebase Auth UID."
    },
    "/teachers/{teacherId}": {
      "schema": "TeacherRecord",
      "description": "School teacher profiles managed by administrators."
    },
    "/gallery/{galleryId}": {
      "schema": "GalleryRecord",
      "description": "School activity and facility gallery items managed by administrators."
    },
    "/registrations/{registrationId}": {
      "schema": "RegistrationRecord",
      "description": "PPDB student registrations owned by the submitting parent or managed by admins."
    },
    "/tuition_bills/{billId}": {
      "schema": "TuitionBillRecord",
      "description": "SPP tuition bills and payment records."
    },
    "/student_reports/{reportId}": {
      "schema": "StudentReportRecord",
      "description": "Holistic student e-raport evaluations."
    },
    "/notification_logs/{logId}": {
      "schema": "NotificationLogRecord",
      "description": "WhatsApp and SMS notification transmission logs."
    },
    "/inquiries/{inquiryId}": {
      "schema": "InquiryRecord",
      "description": "Parent consultation and school tour inquiries from the contact form."
    }
  }
}
