    "RegistrationRecord": {
      "title": "RegistrationRecord",
      "description": "PPDB online student registration record containing student and parent details.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "regNumber": {
          "type": "string",
          "minLength": 3,
          "maxLength": 50
        },
        "childName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "nickname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "nik": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "birthPlace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "birthDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "gender": {
          "type": "string",
          "enum": ["Laki-laki", "Perempuan"],
          "maxLength": 20
        },
        "program": {
          "type": "string",
          "enum": [
            "Playgroup (Usia 2-3 Th)",
            "TK A (Usia 4-5 Th)",
            "TK B (Usia 5-6 Th)",
            "Kelas Tahfidz Cilik (Usia 4-6 Th)"
          ],
          "maxLength": 80
        },
        "parentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "motherName": {
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 256,
          "description": "Verified Gmail address for registration announcements"
        },
        "phone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 30
        },
        "occupation": {
          "type": "string",
          "maxLength": 100
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "status": {
          "type": "string",
          "enum": [
            "Menunggu Verifikasi",
            "Wawancara Terjadwal",
            "Diterima",
            "Berkas Belum Lengkap"
          ],
          "maxLength": 40
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "waSent": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "regNumber",
        "childName",
        "nickname",
        "nik",
        "birthPlace",
        "birthDate",
        "gender",
        "program",
        "parentName",
        "motherName",
        "phone",
        "occupation",
        "address",
        "status",
        "notes",
        "waSent",
        "createdAt",
        "updatedAt"
      ]
    },
