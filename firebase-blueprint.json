        "authorId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "nip": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "education": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "experienceYears": {
          "type": "number"
        },
        "photo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "bio": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "phone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 30
        },
        "specialty": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "authorId",
        "name",
        "nip",
        "role",
        "education",
        "experienceYears",
        "photo",
        "bio",
        "phone",
        "specialty",
        "createdAt",
        "updatedAt"
      ]
    },
